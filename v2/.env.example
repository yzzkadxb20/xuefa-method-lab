# 服务端口
PORT=4180

# 数据目录 / 数据库文件
DATA_DIR=./data
DB_PATH=./data/methodlab.db

# 管理员账号（首次启动创建；部署前必须改密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

# 会话有效期（天）
SESSION_DAYS=7

# Postgres（server-pg.mjs / Netlify + Neon）
# Neon 示例：postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
PGSSL=1

# 本地开发用 development；Netlify 环境里设 production
NODE_ENV=development
